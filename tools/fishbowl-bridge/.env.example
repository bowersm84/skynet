# tools/fishbowl-bridge/.env — copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Fishbowl (read-only service account, Integrated App "SkyNet Bridge" approved in Setup > Settings > Integrated Apps)
FB_HOST=192.168.1.251
FB_PORT=2456
FB_USER=skynet-bridge
FB_PASS=
FB_APP_ID=4350
# hold = keep one Fishbowl session open (default); per_cycle = login/logout around every poll (if a seat is consumed)
SESSION_MODE=hold

# SkyNet / Supabase — TEST project while building, PROD on the Fishbowl server
SB_URL=https://ylzmyjjqibpbqbwjsnqj.supabase.co
SB_ANON_KEY=
SB_BRIDGE_EMAIL=fishbowl-bridge@skybolt.com
SB_BRIDGE_PASSWORD=

# Timing (ms)
POLL_MS=20000
RECONCILE_MS=900000
INVENTORY_MS=300000
USERS_MS=86400000
OVERLAP_REVS=200
CHUNK=50

# Fishbowl location groups whose stock counts as "available to ship" in the Order Queue (D-FB-33).
# 1 Main, 2 Skybolt1, 3 Skybolt2, 4 Skybolt, 5 Skybolt>2, 6 Warehouse, 7 Material, 8 Manufacturing
AVAILABLE_LOCATION_GROUPS=1,6
