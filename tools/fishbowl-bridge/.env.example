# tools/fishbowl-bridge/.env — copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Fishbowl (read-only service account, Integrated App "SkyNet Bridge" approved in Setup > Settings > Integrated Apps)
FB_HOST=192.168.1.251
FB_PORT=2456
FB_USER=skynet-bridge
FB_PASS=
FB_APP_ID=4350
# hold = keep one Fishbowl session open (default); per_cycle = login/logout around every poll (if a seat is consumed)
SESSION_MODE=hold

# SkyNet / Supabase — TEST project while building, PROD on the Fishbowl server
SB_URL=https://ylzmyjjqibpbqbwjsnqj.supabase.co
SB_ANON_KEY=
SB_BRIDGE_EMAIL=fishbowl-bridge@skybolt.com
SB_BRIDGE_PASSWORD=

# Timing (ms)
POLL_MS=20000
RECONCILE_MS=900000
INVENTORY_MS=300000
USERS_MS=86400000
OVERLAP_REVS=200
CHUNK=50

# Pricing mirrors, bridge v1.3 (D-PRICE-26). Nightly times are local wall-clock (America/New_York).
POLL_CUSTOMERS_SEC=900
PRODUCTS_NIGHTLY_AT=02:10
HISTORY_NIGHTLY_AT=02:20
HISTORY_BACKFILL_FROM=2023-11-27
# PART_COSTS_ENABLED=true   D-PRICE-47 part-cost mirror; set false to skip it (runs with the products poll)
# KITS_SYNC_ENABLED=true    D-PRICE-49 push of kit prices to the skybolt-kits site after the products poll
# HISTORY_PAGE=2000     rows per SO-history page read from Fishbowl
# PRICING_BATCH=500     rows per fb_upsert_* call

# D-FB-40 inventory scope. The poller covers every SkyNet part, every part on an open sales order and
# every part already mirrored; a Fishbowl part with no stock record is written as a zero row.
# INVENTORY_DRY_RUN=true   build and log the payload (incl. probe parts) without writing. Default off:
#                          ONLY the literal `true` enables it, so a leftover or misspelt value writes.

# D-PRICE-53 Fishbowl pricing link (bridge v1.7). The rules + product-tree mirrors run in the products
# nightly slot; queued import commands (fb_push_commands) run every cycle.
# FB_PUSH_ENABLED=true     ONLY the literal `true` lets the bridge WRITE to Fishbowl. Default off: every
#                          claimed command runs as a forced dry run (logged, nothing sent).
# FB_PUSH_SB_HOST=luzungoqfuplspzbqctb.supabase.co   the only SkyNet host a real push may run against (PROD)
# FB_PUSH_AUTO=true        nightly fb_push_auto: queue prices + rules pushes when the book in effect changed
# FB_PUSH_MAX_PER_CYCLE=3  commands claimed per 20 s cycle
# FB_IMPORT_TIMEOUT_MS=300000
# RULES_TREE_ENABLED=true  set false to skip the rules/tree mirrors
# FB_IMPORT_PRODUCT=Product  FB_IMPORT_RULES=Pricing-Rules  FB_IMPORT_TREE_CATEGORIES=Product-Tree-Categories
# FB_IMPORT_TREE=Product-Tree  FB_IMPORT_GROUPS=Customer-Group-Relations

# Fishbowl location groups whose stock counts as "available to ship" in the Order Queue (D-FB-33).
# 1 Main, 2 Skybolt1, 3 Skybolt2, 4 Skybolt, 5 Skybolt>2, 6 Warehouse, 7 Material, 8 Manufacturing
AVAILABLE_LOCATION_GROUPS=1,6
